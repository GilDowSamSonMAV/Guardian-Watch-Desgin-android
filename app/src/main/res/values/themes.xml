<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Base app theme. Compose owns all styling; this is just the launch window. -->
    <style name="Theme.GuardianWatch" parent="android:Theme.Material.NoActionBar.Fullscreen">
        <item name="android:windowBackground">@color/bg_000</item>
        <item name="android:statusBarColor">@color/bg_000</item>
        <item name="android:navigationBarColor">@color/bg_000</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar">false</item>
        <item name="android:forceDarkAllowed" tools:targetApi="29">false</item>
    </style>
</resources>
